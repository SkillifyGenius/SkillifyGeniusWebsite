{
  "name": "skillifygenius-monorepo",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @skillify/frontend",
    "dev:frontend": "npm run dev --workspace @skillify/frontend",
    "dev:backend": "npm run dev --workspace @skillify/backend",
    "build": "npm run build --workspace @skillify/frontend",
    "typecheck": "npm run typecheck --workspace @skillify/frontend",
    "test": "npm test --prefix functions/telegram-trial-alert",
    "build:backend": "npm run build --workspace @skillify/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
